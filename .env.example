# -----------------------------------------------------------------------------
# Book Planet — environment configuration
# Copy to .env and run `php artisan key:generate`. Never commit .env.
# -----------------------------------------------------------------------------

APP_NAME="Book Planet"
# local | staging | production
APP_ENV=local
APP_KEY=
# MUST be false in production: debug pages leak configuration and secrets.
APP_DEBUG=true
# The public URL (used for links, the sitemap, Stripe redirects and /storage URLs).
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Behind a load balancer / reverse proxy (Forge, Fly, Render, Cloudflare, ...):
# set to "*" or a comma-separated list of proxy IPs so HTTPS is detected.
# TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use "warning" or "error" in production.
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# Local development uses SQLite (database/database.sqlite is created for you).
DB_CONNECTION=sqlite
# Production: MySQL 8 / MariaDB 10.6+ / PostgreSQL 14+
# DB_CONNECTION=mysql        # or mariadb / pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306               # 5432 for pgsql
# DB_DATABASE=bookplanet
# DB_USERNAME=bookplanet
# DB_PASSWORD=

# --- Sessions / cache / queue ---------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Recommended in production (HTTPS only): SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Files ----------------------------------------------------------------------
# Default disk. Ebooks are always written to the private "local" disk
# (storage/app/private) and only served through the authorised download route;
# covers and author photos go to the "public" disk (run `php artisan storage:link`).
FILESYSTEM_DISK=local
# EBOOK_DISK=local
# MEDIA_DISK=public
# Upload limits in KB. Keep PHP upload_max_filesize/post_max_size and your web
# server's body size limit (nginx client_max_body_size) at least this large.
EBOOK_MAX_KB=51200
IMAGE_MAX_KB=2048

# --- Stripe -----------------------------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys (live keys in production).
STRIPE_KEY=
STRIPE_SECRET=
# Signing secret of the webhook endpoint (https://your-domain/stripe/webhook),
# or the one printed by `stripe listen --forward-to localhost:8000/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- Mail -------------------------------------------------------------------------
# Password-reset emails need a real mailer in production (smtp, postmark, ses, resend...).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bookplanet.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
